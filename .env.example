# Backend LLM provider: "anthropic" (default) or "mock" (deterministic, for tests).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Models (defaults shown). Widget generation / interpreter / judge:
LLM_MODEL_GENERATION=claude-opus-5-5
# Widget runtime inference, activity model:
LLM_MODEL_INFERENCE=claude-sonnet-5-5
# Fast stages (step interpreter, assist decide):
LLM_MODEL_FAST=claude-haiku-5-5
BACKEND_PORT=8787
# Shared secret the extension sends with backend requests (any random string).
EXTENSION_AUTH_TOKEN=dev-token-change-me
# sqlite file (llm_calls, data store, jobs, …)
DATA_DB_PATH=.data/store.db
