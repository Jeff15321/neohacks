# Backend LLM provider. "anthropic" (default) or "openai" or "mock" (deterministic, for tests).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
# Model used to generate widget code.
LLM_GENERATION_MODEL=claude-sonnet-4-5
# Model used for widget inference calls (fast + cheap is good).
LLM_INFERENCE_MODEL=claude-haiku-4-5
BACKEND_PORT=8787
# Shared secret the extension sends with backend requests (any random string).
EXTENSION_AUTH_TOKEN=dev-token-change-me
