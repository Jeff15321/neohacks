{
  "manifest_version": 3,
  "name": "Widget AI — Website Widget Builder",
  "version": "0.2.0",
  "description": "Describe a feature; get a generated userscript widget that modifies the page.",
  "minimum_chrome_version": "135",
  "key": "",
  "permissions": ["userScripts", "tabs", "sidePanel", "storage", "webRequest", "webNavigation", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "action": { "default_title": "Widget AI" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["netprobe.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" },
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }
  ],
  "commands": {
    "toggle-recording": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Start/stop recording a workflow" }
  },
  "icons": {}
}
